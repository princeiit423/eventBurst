<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Innovation Center</title>
  <link rel="icon" href="src/favion.png" type="image/x-icon">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Raleway:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" integrity="sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <style>
    
    .event-title {
      font-family: 'Playfair Display', serif;
    }
    
  
        /* Responsive design adjustments */
        @media (max-width: 768px) {
          .header {
            padding: 10px 4px;
            position:static;
          }
          .header nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
            text-align:right
          }
          .header nav a, .header nav button {
            font-size: 14px;
            text-align:right;
          }
        }

    
  </style>
</head>
<body class="bg-gray-100">

   <!-- Header -->
   <header class="header flex justify-between items-center py-4 px-8 bg-white shadow-md  w-full top-0 z-50">
    <div class="text-2xl font-bold text-indigo-600">Student <span class="text-black">Innovation</span> Center</div>
    <nav class="space-x-6 text-sm">
      <a href="/" class="hover:text-indigo-600">Home</a>
      <a href="/upcomingevent" class="hover:text-indigo-600">Upcoming Events</a>
      <a href="/pastEvent" class="hover:text-indigo-600">Past Events</a>
      <a href="/profile" class="hover:text-indigo-600">Profile</a>
      <a href="/contact" class="hover:text-indigo-600">Contacts</a>
      <a href="/admin" class="hover:text-indigo-600">Admin</a>
      <% if(admi){ %>
        <a href="/logout" class="px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">Logout</a>
      <% } else { %>
      <a href="/login" class="px-4 py-2 text-purple-600 hover:underline">Login</a>
      <a href="/signup" class="px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">Signup</a>
    <% } %>
    </nav>
  </header>

  <!-- Main Content -->
  <main class="pt-16 px-6 lg:px-16">
    <!-- Event Details and Image Section -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-10 ">
      <!-- Event Info Card -->
      <div class="p-8 bg-white rounded-lg shadow-lg border border-gray-200">
        <h2 class="text-4xl font-semibold mb-6 text-indigo-600 event-title"><%=singleEvent.title %></h2>
        <p class="text-gray-700 mb-4"><%=singleEvent.description %></p>
        <ul class="list-disc pl-5 text-gray-600 mb-4">
          <li><strong>Date:</strong> <%=singleEvent.dateOfEvent.toLocaleDateString('en-US', {
            weekday: 'short',
            month: 'short',
            day: 'numeric',
            year: 'numeric',
          }) %></li>
         <!-- <li><strong>Time:</strong> 10:00 AM - 5:00 PM</li>-->
          <li><strong>Location:</strong> <%=singleEvent.location%></li>
          <li><strong>Organised By:</strong> <%=singleEvent.club%></li>
          <li><strong>Registration Fee:</strong> <%=singleEvent.entryFee%></li>
        </ul>
        <div class="bg-indigo-50 p-6 rounded-lg mt-6">
          <h3 class="text-2xl font-semibold text-indigo-700 mb-4">Why You Should Join?</h3>
          <ul class="list-disc pl-5 text-gray-700 space-y-2">
            <li>💡 **Expand Your Knowledge:** Gain insights into cutting-edge technologies and tools shaping the future.</li>
            <li>👩‍💻 **Hands-On Learning:** Practical sessions to enhance your skills and bring ideas to life.</li>
            <li>🌐 **Networking Opportunities:** Meet industry leaders and like-minded tech enthusiasts.</li>
            <li>🚀 **Boost Your Career:** Certificate of participation to showcase on your resume and LinkedIn.</li>
            <li>🏆 **Exciting Perks:** Get a chance to win exclusive goodies and discounts for future events.</li>
          </ul>
        </div>
      
        <% if(fee === "free" || fee === "Free" || fee === "na" || fee === "NA" || fee === "Na" || fee === "N/A" || fee === "FREE") { %>
          <a href="/upcomingevent/<%=singleEvent._id %>/register-free"><button class="mt-3 px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition duration-300">Register Now</button></a>
          <% } else{%>
        <a href="/upcomingevent/<%=singleEvent._id %>/register"><button class="mt-3 px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition duration-300">Register Now</button></a>
       <% } %>

        <% if(username==="iei786" ){ %>
        <a href="/upcomingevent/<%=singleEvent._id %>/participation"><button href="#" class="mt-3 px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition duration-300">See Participation</button></a>
        <form method="post" action="/upcomingevent/<%=singleEvent._id %>?_method=DELETE"><button href="#" class="mt-3 px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition duration-300">Delete Event</button></form>
          <%}%>
      </div>

      <!-- Poster Image Section -->
      <div class="h-full overflow-hidden rounded-lg bg-gray-200 shadow-lg">
        <img class="object-cover w-full h-full" src="<%=singleEvent.posterUrl%>" alt="Event Poster">
      </div>
    </section>


    <!-- Collaborating Partners -->
    <section class="mb-10">
      <h2 class="text-3xl font-bold text-center mb-6 text-indigo-600">Our Collaborative Partners</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
        <img src="https://i.postimg.cc/g02zN6F8/AEC.png" alt="Partner 1" class="object-contain h-16 w-full">
        <img src="https://i.postimg.cc/76Cxy8LL/IEI.png" alt="Partner 2" class="object-contain h-16 w-full">
        <img src="https://i.postimg.cc/N0CgVfBV/SIC.png" alt="Partner 3" class="object-contain h-16 w-full">
        <img src="https://i.postimg.cc/Dy0ckxrM/Pngtree-circuit-line-icon-9006706-1.png" alt="Partner 3" class="object-contain h-16 w-full">
        
      </div>
    </section>

    <!-- Event Rating and Comment Section -->
     <form method="POST" action="/upcomingevent/<%=singleEvent._id %>/review">
<section class="bg-white p-8 rounded-lg shadow-lg border border-gray-200 mb-10">
    <h2 class="text-3xl font-bold text-center mb-6 text-indigo-600">Rate and Share Your Experience</h2>
  
    <!-- Rating Section -->
    <div class="mb-4">
      <p class="text-gray-700 mb-2">Rate this event:</p>
      <div class="flex justify-center">
      <!-- Star Rating with Animation -->
<div class="flex justify-center items-center space-x-1 py-5">
  <div class="flex space-x-1">
    <!-- Star 1 -->
    <input type="radio" id="reviews" name="reviews" value="1" class="hidden peer" />
    <label for="rate1" class="text-gray-400 text-3xl cursor-pointer transition-transform transform hover:scale-125 peer-checked:text-yellow-500 peer-checked:before:block peer-checked:before:text-yellow-500">
      ⭐
    </label>

    <!-- Star 2 -->
    <input type="radio" id="reviews" name="reviews" value="2" class="hidden peer" />
    <label for="rate2" class="text-gray-400 text-3xl cursor-pointer transition-transform transform hover:scale-125 peer-checked:text-yellow-500 peer-checked:before:block peer-checked:before:text-yellow-500">
      ⭐
    </label>

    <!-- Star 3 -->
    <input type="radio" id="reviews" name="reviews" value="3" class="hidden peer" />
    <label for="rate3" class="text-gray-400 text-3xl cursor-pointer transition-transform transform hover:scale-125 peer-checked:text-yellow-500 peer-checked:before:block peer-checked:before:text-yellow-500">
      ⭐
    </label>

    <!-- Star 4 -->
    <input type="radio" id="reviews" name="reviews" value="4" class="hidden peer" />
    <label for="rate4" class="text-gray-400 text-3xl cursor-pointer transition-transform transform hover:scale-125 peer-checked:text-yellow-500 peer-checked:before:block peer-checked:before:text-yellow-500">
      ⭐
    </label>

    <!-- Star 5 -->
    <input type="radio" id="reviews" name="reviews" value="5" class="hidden peer" />
    <label for="rate5" class="text-gray-400 text-3xl cursor-pointer transition-transform transform hover:scale-125 peer-checked:text-yellow-500 peer-checked:before:block peer-checked:before:text-yellow-500">
      ⭐
    </label>
  </div>
</div>
  
      </div>
    </div>
  
    <!-- Comment Section -->
    <div>
      <p class="text-gray-700 mb-2">Leave your comments:</p>
      <textarea name="comment" id="comment" class="w-full border border-gray-300 rounded-lg p-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all duration-200" rows="4" placeholder="Share your thoughts about the event..."></textarea>
      <button class="mt-3 px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition duration-300 transform hover:translate-y-1">Submit</button>
    </div>
  </section>
</form>

  <!-- User Ratings and Comments Section -->
<section class="bg-gray-100 p-8 rounded-lg shadow-lg border border-gray-200 mb-10">
    <h2 class="text-3xl font-bold text-center mb-6 text-indigo-600">User Ratings & Comments</h2>
  
    <!-- User Comment 1 -->
     <% for (rev of singleEvent.reviews){ %>
    <div class="flex items-start space-x-4 mb-6 p-4 bg-white rounded-lg shadow-sm">
      <img src="https://i.postimg.cc/GpVgmWTq/10200-10-08.jpg" alt="User Avatar" class="w-12 h-12 rounded-full object-cover border border-gray-300">
      <div class="flex-1">
        <div class="flex items-center mb-2">
          <p class="font-semibold text-indigo-600"><%=rev.author.username %></p>
          <div class="flex ml-2">
            <span class="text-yellow-500 text-xl">★</span>
            <span class="text-yellow-500 text-xl">★</span>
            <span class="text-yellow-500 text-xl">★</span>
            <span class="text-yellow-500 text-xl">★</span>
            <span class="text-yellow-500 text-xl">★</span>
          </div>
        </div>
        <p class="text-gray-700"><%=rev.comment%></p>
        <% if(userId.equals(rev.author._id) || username==="iei786"){ %>
        <form method="post" action="/upcomingevent/<%=singleEvent._id %>/reviews/<%=rev._id %>?_method=DELETE">
        <button type="submit"><i class="fa-solid fa-trash text-red-700"></i></button>
      </form>
      <% } %>
      </div>
      </div>
    </div>
    <% } %>
  </section>

  
  </main>
  
 
 <!-- Footer -->
<footer class="bg-indigo-900 text-white py-12">
    <div class="max-w-7xl mx-auto px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- About Us -->
      <div>
        <h2 class="font-bold text-lg">Student Innovation Center</h2>
        <p class="mt-4 text-gray-400">
          Your ultimate platform to host, organize, and explore incredible events.
        </p>
      </div>
      <!-- Quick Links -->
      <div>
        <h2 class="font-bold text-lg">Quick Links</h2>
        <ul class="mt-4 space-y-2">
          <li><a href="#" class="hover:underline">Home</a></li>
          <li><a href="#upcoming" class="hover:underline">Upcoming Events</a></li>
          <li><a href="#past" class="hover:underline">Past Events</a></li>
          <li><a href="#contacts" class="hover:underline">Contacts</a></li>
        </ul>
      </div>
      <!-- Support -->
      <div>
        <h2 class="font-bold text-lg">Support</h2>
        <ul class="mt-4 space-y-2">
          <li><a href="#" class="hover:underline">Help Center</a></li>
          <li><a href="#" class="hover:underline">FAQs</a></li>
          <li><a href="#" class="hover:underline">Terms & Conditions</a></li>
          <li><a href="#" class="hover:underline">Privacy Policy</a></li>
        </ul>
      </div>
      <!-- Contact Us -->
      <div>
        <h2 class="font-bold text-lg">Contact Us</h2>
        <p class="mt-4 text-gray-400">
          Email: <a href="mailto:info@eventhive.com" class="underline">info@eventhive.com</a>
        </p>
        <p class="mt-2 text-gray-400">
          Phone: +123 456 7890
        </p>
        <div class="mt-4 flex space-x-4" style="width:5rem;">
          <a href="#" class="hover:opacity-75">
            <img src="src/facebook.png" alt="Facebook">
          </a>
          <a href="#" class="hover:opacity-75">
            <img src="src/instagram.png" alt="Twitter">
          </a>
          <a href="#" class="hover:opacity-75">
            <img src="src/linkedin.png" alt="LinkedIn">
          </a>
        </div>
      </div>
    </div>
    <div class="mt-8 text-center text-sm text-gray-400">
      © 2024 Student Innovation Center. All rights reserved.
    </div>
  </footer>
</body>
<script>
   
  </script>
</html>
