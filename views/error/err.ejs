<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Event Hive</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 flex flex-col min-h-screen">


  <!-- Main Content -->
  <main class="flex-grow flex flex-col items-center justify-center text-center px-4">
    <div class="w-full max-w-md">
      <img src="src/error.png" alt="404 Illustration" class="mx-auto mb-6" />
      <h2 class="text-gray-700 text-3xl font-bold mt-4">Oops!</h2>
      <p class="text-gray-500 mt-2"><%=err.message%></p>
      <a href="/" class="mt-6 inline-block px-6 py-3 bg-purple-600 text-white rounded-lg shadow-md hover:bg-purple-700">Back to Homepage</a>
    </div>

  </main>

  
</body>
</html>
