<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Student Innovation Center</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 min-h-screen">

  <div class="container mx-auto my-8 p-6 bg-white rounded shadow-md">
    <h1 class="text-2xl font-bold mb-4"><span class="text-indigo-600">Event Participation for</span> <%= participation.title %></h1>
    <h3 class="text-2xl mb-3 ">Total Participation: <%=participation.userregister.length%> </h3>
    
    <% if (participation.userregister.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-gray-200 text-gray-600">
              <th class="px-4 py-2 border">Image</th>
              <th class="px-4 py-2 border">Name</th>
              <th class="px-4 py-2 border">Whatsapp</th>
              <th class="px-4 py-2 border">Email</th>
              <th class="px-4 py-2 border">Department</th>
              <th class="px-4 py-2 border">Roll</th>
              <th class="px-4 py-2 border">Semester</th>
              <th class="px-4 py-2 border">Transaction ID</th>
              <th class="px-4 py-2 border">Date</th>
              <th class="px-4 py-2 border">Verified</th> <!-- Added Verified column -->
            </tr>
          </thead>
          <tbody>
            <% participation.userregister.forEach((reg) => { %>
              <tr class="border-b hover:bg-gray-100">
                <td class="px-4 py-2 border text-center">
                  <% if (reg.image && reg.image.url) { %>
                    <a href="<%= reg.image.url %>" ><img class="w-16 h-16 object-cover rounded" src="<%= reg.image.url %>" alt="User Image"></a>
                  <% } else { %>
                    <span>No Image</span>
                  <% } %>
                </td>
                <td class="px-4 py-2 border text-center"><%= reg.name %></td>
                <td class="px-4 py-2 border text-center"><%= reg.whatsapp %></td>
                <td class="px-4 py-2 border text-center"><%= reg.email %></td>
                <td class="px-4 py-2 border text-center"><%= reg.department %></td>
                <td class="px-4 py-2 border text-center"><%= reg.roll %></td>
                <td class="px-4 py-2 border text-center"><%= reg.semester %></td>
                <td class="px-4 py-2 border text-center"><%= reg.txn %></td>
                <td class="px-4 py-2 border text-center"><%= reg.date.toDateString() %></td>
                <td class="px-4 py-2 border text-center">
                  <input type="checkbox" class="form-checkbox" >
                </td> <!-- Checkbox for verification -->
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-center text-gray-600">No participants have registered for this event yet.</p>
    <% } %>
  </div>

</body>
</html>
