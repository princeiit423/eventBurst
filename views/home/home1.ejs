<!-- Words from Our College Principal, HOD, and Coordinator -->
<section class="bg-gradient-to-r from-indigo-500 via-purple-500 to-blue-500 py-12">
  <div class="container mx-auto px-6">
    <!-- Section Title -->
    <h2 class="text-3xl font-extrabold text-white text-center mb-8 tracking-wide">
      Words from Our Mentors
    </h2>

    <!-- Mentor Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Principal's Section -->
      <div class="bg-white border border-gray-200 shadow-lg rounded-lg p-4 transform hover:scale-105 transition duration-300">
        <img src="src/gs.jpg" alt="Principal Image" class="w-24 h-24 mx-auto rounded-full border-4 border-indigo-600 mb-4 shadow-lg">
        <h3 class="text-lg font-semibold text-indigo-600 mb-2">Dr. Gourishankar Panda</h3>
        <p class="text-gray-700 mb-2"><strong>Position:</strong> Vice Principal, AEC</p>
        <blockquote class="text-gray-600 italic leading-relaxed mb-4 text-xs">
