          <p class="text-gray-700 mb-1"><strong>Position:</strong> Student Coordinator, I.E.I</p>
          <p class="text-gray-700 mb-3"><strong>Contact:</strong> +918581088590</p>
          <p class="text-gray-700 mb-3">Developer of this website.<span class="text-indigo-400"><a href="https://www.linkedin.com/in/faiz-hussain-257001250/">Visit Linkedin</a></span></p>
          <button class="bg-indigo-600 text-white py-2 px-5 rounded-lg hover:bg-indigo-700 transition duration-300">Call Now</button>
        </div>

        <!-- Another Coordinator Card -->
        <div class="card bg-white border border-gray-200 rounded-lg shadow-lg overflow-hidden transition transform duration-300 p-6 text-center">
          <img src="src/apoorv.jpg" alt="Coordinator Image" class="circle-image mx-auto mb-4">
          <h2 class="text-2xl font-semibold text-indigo-600 mb-2">Apoorva Pandit</h2>
          <p class="text-gray-700 mb-1"><strong>Department:</strong> Electronics and Communication Engineering</p>
          <p class="text-gray-700 mb-1"><strong>Batch:</strong> 2022-2026</p>
          <p class="text-gray-700 mb-1"><strong>Position:</strong> Student Coordinator, I.E.I</p>
          <p class="text-gray-700 mb-3"><strong>Contact:</strong> +916892344561</p>
          <button class="bg-indigo-600 text-white py-2 px-5 rounded-lg hover:bg-indigo-700 transition duration-300">Call Now</button>
        </div>

        <!-- More Cards -->
        <div class="card bg-white border border-gray-200 rounded-lg shadow-lg overflow-hidden transition transform duration-300 p-6 text-center">
          <img src="src/aqdas_.jpg" alt="Coordinator Image" class="circle-image mx-auto mb-4">
          <h2 class="text-2xl font-semibold text-indigo-600 mb-2">Aqdas Sultan</h2>
          <p class="text-gray-700 mb-1"><strong>Department:</strong> Electronics and Communication Engineering</p>
          <p class="text-gray-700 mb-1"><strong>Batch:</strong> 2022-2026</p>
          <p class="text-gray-700 mb-1"><strong>Position:</strong> Co-convener, SIC</p>
          <p class="text-gray-700 mb-3"><strong>Contact:</strong> +9189966773421</p>
          <button class="bg-indigo-600 text-white py-2 px-5 rounded-lg hover:bg-indigo-700 transition duration-300">Call Now</button>
        </div>
      </div>
    </div>
  </section>
 <!-- Footer -->
 <footer class="bg-indigo-900 text-white py-12">
