<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Innovation Center</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-gray-900 to-gray-700 flex items-center justify-center min-h-screen">
  <div class="w-11/12 max-w-lg p-6 bg-gray-800 shadow-lg rounded-lg text-center text-white">
    <!-- Lock Icon -->
    <div class="text-6xl text-red-500 mb-6">
      <i class="fas fa-lock"></i>
    </div>

    <!-- Heading -->
    <h1 class="text-3xl font-bold text-red-400 mb-4">Access Denied</h1>

    <!-- Description -->
    <p class="text-gray-300 mb-6 leading-relaxed">
      Oops! You don't have permission to access this page. If you believe this is a mistake, please contact the administrator.
    </p>

    <!-- Go Back Button -->
    <button 
      onclick="goBack()" 
      class="px-6 py-3 text-lg font-semibold text-gray-900 bg-red-400 rounded-lg hover:bg-red-500 transition duration-300"
    >
      Go Back
    </button>
  </div>

  <!-- Back Navigation Script -->
  <script>
    function goBack() {
      window.history.back();
    }
  </script>

  <!-- FontAwesome -->
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
</body>
</html>
