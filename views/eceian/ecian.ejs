<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Innovation Center</title>
  <link rel="icon" href="src/favion.png" type="image/x-icon">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Montserrat:wght@400;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <style>
    .poster-image {
      animation: slideIn 1s ease-out;
    }

    .winner-details {
      animation: fadeIn 1.5s ease-in;
    }

    @keyframes slideIn {
      from {
        transform: translateX(-50%);
        opacity: 0;
      }
      to {
        transform: translateX(0);
        opacity: 1;
      }
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

        /* Responsive design adjustments */
        @media (max-width: 768px) {
          .header {
            padding: 10px 4px;
            position:static;
          }
          .header nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
            text-align:right
          }
          .header nav a, .header nav button {
            font-size: 14px;
            text-align:right;
          }
        }
          
  </style>
</head>
<body class="bg-gray-100 font-sans">
    
  <!-- Header -->
  <header class="header flex justify-between items-center py-4 px-8 bg-white shadow-md  w-full top-0 z-50">
    <div class="text-2xl font-bold text-indigo-600">Student <span class="text-black">Innovation</span> Center</div>
    <nav class="space-x-6 text-sm">
      <a href="/" class="hover:text-indigo-600">Home</a>
      <a href="/upcomingevent" class="hover:text-indigo-600">Upcoming Events</a>
      <a href="/pastEvent" class="hover:text-indigo-600">Past Events</a>
      <a href="/profile" class="hover:text-indigo-600">Profile</a>
      <a href="/contact" class="hover:text-indigo-600">Contacts</a>
      <a href="/admin" class="hover:text-indigo-600">Admin</a>
      <% if(admi){ %>
        <a href="/logout" class="px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">Logout</a>
      <% } else { %>
      <a href="/login" class="px-4 py-2 text-purple-600 hover:underline">Login</a>
      <a href="/signup" class="px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">Signup</a>
    <% } %>
    </nav>
  </header>
  
  <div class="flex items-center justify-center">
    <a href="/leaderboard">
    <button class="flex items-center justify-center bg-purple-600 text-white font-bold p-3 mt-3 rounded-xl">
      View Leaderboard
    </button>
  </a>
  </div>
    
  <!-- ECEian of the Week Section -->
   <% for(e of winners) { %>
  <div class="max-w-6xl mx-auto my-10 p-6 bg-white rounded-lg shadow-lg border border-gray-200 flex flex-col md:flex-row items-center space-y-6 md:space-y-0">

    <!-- Left Section: Poster Image -->
    <div class="md:w-1/2 flex items-center justify-center poster-image">
      <img src="<%=e.imageUrl%>" alt="ECEian of the Week Poster" class="w-full max-w-sm rounded-lg shadow-lg border border-gray-300">
    </div>

    <!-- Right Section: Winner Details -->
    <div class="md:w-1/2 p-6 winner-details">
      <h2 class="text-4xl font-bold text-indigo-600 mb-4 text-center md:text-left">ECEian of the Week</h2>
      <p class="text-lg text-gray-700 mb-6 text-center md:text-left">
        Congratulations to <span class="font-bold text-indigo-500"><%=e.name%></span> for being selected as the ECEian of the Week! Your outstanding contributions and dedication to excellence have truly set you apart.
      </p>
      <ul class="list-disc pl-5 text-gray-600 mb-4">
        <li><strong>Achievement:</strong> Outstanding performance in the ECEian of the week.</li>
        <li><strong>Department:</strong> <%=e.department%></li>
        <li><strong>Semester:</strong> <%=e.semester%></li>
        <li><strong>Date:</strong><%=e.date.toLocaleDateString('en-US', {
          weekday: 'short',
          month: 'short',
          day: 'numeric',
          year: 'numeric',
        })%></li>
      </ul>
      <blockquote class="text-lg font-medium italic text-indigo-500 border-l-4 border-indigo-500 pl-4">
        "Your hard work and perseverance inspire us all. Keep shining and reaching new heights!"
      </blockquote>
    <% if(admi.username == "iei786"){ %>
      <form method="post" action="/admin/winner/<%=e._id %>?_method=DELETE" ><button class="bg-red-600 text-white p-2 rounded-xl mt-5">Delete</button></form>
    
    <% } %>  
      
    </div>

  </div>
<% } %>
  
 
 <!-- Footer -->
<footer class="bg-indigo-900 text-white py-12">
  <div class="max-w-7xl mx-auto px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
    <!-- About Us -->
    <div>
      <h2 class="font-bold text-lg">Student Innovation Center</h2>
      <p class="mt-4 text-gray-400">
        Your ultimate platform to host, organize, and explore incredible events.
      </p>
    </div>
    <!-- Quick Links -->
    <div>
      <h2 class="font-bold text-lg">Quick Links</h2>
      <ul class="mt-4 space-y-2">
        <li><a href="#" class="hover:underline">Home</a></li>
        <li><a href="#upcoming" class="hover:underline">Upcoming Events</a></li>
        <li><a href="#past" class="hover:underline">Past Events</a></li>
        <li><a href="#contacts" class="hover:underline">Contacts</a></li>
      </ul>
    </div>
    <!-- Support -->
    <div>
      <h2 class="font-bold text-lg">Support</h2>
      <ul class="mt-4 space-y-2">
        <li><a href="#" class="hover:underline">Help Center</a></li>
        <li><a href="#" class="hover:underline">FAQs</a></li>
        <li><a href="#" class="hover:underline">Terms & Conditions</a></li>
        <li><a href="#" class="hover:underline">Privacy Policy</a></li>
      </ul>
    </div>
    <!-- Contact Us -->
    <div>
      <h2 class="font-bold text-lg">Contact Us</h2>
      <p class="mt-4 text-gray-400">
        Email: <a href="mailto:info@eventhive.com" class="underline">info@eventhive.com</a>
      </p>
      <p class="mt-2 text-gray-400">
        Phone: +123 456 7890
      </p>
      <div class="mt-4 flex space-x-4" style="width:5rem;">
        <a href="#" class="hover:opacity-75">
          <img src="src/facebook.png" alt="Facebook">
        </a>
        <a href="#" class="hover:opacity-75">
          <img src="src/instagram.png" alt="Twitter">
        </a>
        <a href="#" class="hover:opacity-75">
          <img src="src/linkedin.png" alt="LinkedIn">
        </a>
      </div>
    </div>
  </div>
  <div class="mt-8 text-center text-sm text-gray-400">
    © 2024 Student Innovation Center. All rights reserved.
  </div>
</footer>
</body>
</html>
