<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Innovation Center</title>
  <link rel="icon" href="https://i.postimg.cc/T3X9pFpN/android-chrome-192x192.png" type="image/x-icon">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Montserrat:wght@400;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <style>
    @media (max-width: 640px) {
      .max-w-4xl {
        max-width: 100%;
        padding: 5px;
      }
      .text-4xl {
        font-size: 2rem;
      }
      .w-48 {
        width: 100px;
      }
      .h-48 {
        height: 100px;
      }
    }

    
        /* Responsive design adjustments */
        @media (max-width: 768px) {
          .header {
            padding: 10px 4px;
            position:static;
          }
          .header nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
            text-align:right
          }
          .header nav a, .header nav button {
            font-size: 14px;
            text-align:right;
          }
        }
          
  </style>
</head>
<body class="bg-gray-100 font-sans">
  <!-- Header -->
  <header class="header flex justify-between items-center py-4 px-8 bg-white shadow-md  w-full top-0 z-50">
    <div class="text-2xl font-bold text-indigo-600">Student <span class="text-black">Innovation</span> Center</div>
    <nav class="space-x-6 text-sm">
      <a href="/" class="hover:text-indigo-600">Home</a>
      <a href="/upcomingevent" class="hover:text-indigo-600">Upcoming Events</a>
      <a href="/pastEvent" class="hover:text-indigo-600">Past Events</a>
      <a href="/profile" class="hover:text-indigo-600">Profile</a>
      <a href="/contact" class="hover:text-indigo-600">Contacts</a>
      <a href="/admin" class="hover:text-indigo-600">Admin</a>
      <% if(admi){ %>
        <a href="/logout" class="px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">Logout</a>
      <% } else { %>
      <a href="/login" class="px-4 py-2 text-purple-600 hover:underline">Login</a>
      <a href="/signup" class="px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">Signup</a>
    <% } %>
    </nav>
  </header>
  

  <!-- Registration Form Container -->
  <div class="max-w-4xl mx-auto my-10 p-8 bg-white rounded-lg shadow-lg border border-gray-200">
    <h2 class="text-4xl font-bold mb-6 text-indigo-600 text-center">Event Registration</h2>
    <p class="text-gray-700 mb-6 text-center">Join us for the Tech Workshop 2024 by filling out the form below. Ensure accurate details for a seamless registration experience.</p>

    <!-- Registration Form -->
    <form class="space-y-6" method="post" action="/upcomingevent/<%=singleEvent._id%>/register" enctype="multipart/form-data">
      <!-- Name Field -->
      <div>
        <label for="name" class="block text-gray-800 font-medium mb-2">Name</label>
        <input type="text" id="name" name="name" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-300 shadow-sm" placeholder="John Doe" required>
      </div>

      <!-- Department Field -->
      <div>
        <label for="department" class="block text-gray-800 font-medium mb-2">Department</label>
        <input type="text" id="department" name="department" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-300 shadow-sm" placeholder="ECE" required>
      </div>

            <!-- Semester field -->
            <div>
              <label for="semester" class="block text-gray-800 font-medium mb-2">Semester</label>
              <input type="number" id="semester" name="semester" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-300 shadow-sm" placeholder="04" required>
            </div>

                        <!-- Whatsapp field -->
                        <div>
                          <label for="whatsapp" class="block text-gray-800 font-medium mb-2">Whatsapp No.</label>
                          <input type="number" id="whatsapp" name="whatsapp" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-300 shadow-sm" placeholder="8345445556" required>
                        </div>

      <!-- Email Field -->
      <div>
        <label for="email" class="block text-gray-800 font-medium mb-2">Email</label>
        <input type="email" id="email" name="email" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-300 shadow-sm" placeholder="example@domain.com" required>
      </div>

      <!-- University Roll No. Field -->
      <div>
        <label for="roll-no" class="block text-gray-800 font-medium mb-2">University Roll No.</label>
        <input type="number" id="roll" name="roll" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-300 shadow-sm" placeholder="2023CS001" required>
      </div>

      <!-- QR Code Display -->
      <div class="flex flex-col items-center mt-6 mb-4">
        <label class="block text-gray-800 font-medium mb-2">Scan QR Code</label>
        <div class="w-48 h-48 bg-gray-100 flex items-center justify-center border border-gray-300 rounded-lg shadow-sm">
          <img src="path-to-your-qr-code.png" alt="QR Code" class="w-full h-full object-cover">
        </div>
      </div>


      <!-- Upload Payment Screenshot Field -->
      <div>
        <label for="image" class="block text-gray-800 font-medium mb-2">Upload Payment Screenshot</label>
        <input type="file" id="image" name="image" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-300 shadow-sm" required>
      </div>

      <!-- Transaction ID Field -->
      <div>
        <label for="transaction-id" class="block text-gray-800 font-medium mb-2">Transaction ID</label>
        <input type="text" id="txn" name="txn" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-300 shadow-sm" placeholder="TXN123456789" required>
      </div>

      <!-- Submit Button -->
      <div class="flex justify-center mt-6">
        <button type="submit" class="px-6 py-3 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition duration-300 w-full sm:w-auto">Register</button>
      </div>
    </form>

    <!-- Information Card -->
    <div class="mt-10 p-6 bg-indigo-50 border-l-4 border-indigo-600 shadow-lg rounded-lg">
      <h3 class="text-2xl font-semibold text-indigo-700 mb-3">Important Information</h3>
      <p class="text-gray-800 mb-4">Ensure that all details are correct before submitting. The QR code can be scanned to verify your registration.</p>
      <ul class="list-disc pl-5 text-gray-600">
        <li>Bring a valid ID for verification.</li>
        <li>Registration is confirmed only after payment.</li>
        <li>Contact support for any registration issues.</li>
      </ul>
    </div>
  </div>

  <!-- Tailwind CSS Responsive Styling -->
  
 <!-- Footer -->
<footer class="bg-indigo-900 text-white py-12">
  <div class="max-w-7xl mx-auto px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
    <!-- About Us -->
    <div>
      <h2 class="font-bold text-lg">Student Innovation Center</h2>
      <p class="mt-4 text-gray-400">
        Your ultimate platform to host, organize, and explore incredible events.
      </p>
    </div>
    <!-- Quick Links -->
    <div>
      <h2 class="font-bold text-lg">Quick Links</h2>
      <ul class="mt-4 space-y-2">
        <li><a href="#" class="hover:underline">Home</a></li>
        <li><a href="#upcoming" class="hover:underline">Upcoming Events</a></li>
        <li><a href="#past" class="hover:underline">Past Events</a></li>
        <li><a href="#contacts" class="hover:underline">Contacts</a></li>
      </ul>
    </div>
    <!-- Support -->
    <div>
      <h2 class="font-bold text-lg">Support</h2>
      <ul class="mt-4 space-y-2">
        <li><a href="#" class="hover:underline">Help Center</a></li>
        <li><a href="#" class="hover:underline">FAQs</a></li>
        <li><a href="#" class="hover:underline">Terms & Conditions</a></li>
        <li><a href="#" class="hover:underline">Privacy Policy</a></li>
      </ul>
    </div>
    <!-- Contact Us -->
    <div>
      <h2 class="font-bold text-lg">Contact Us</h2>
      <p class="mt-4 text-gray-400">
        Email: <a href="mailto:info@eventhive.com" class="underline">info@eventhive.com</a>
      </p>
      <p class="mt-2 text-gray-400">
        Phone: +123 456 7890
      </p>
      <div class="mt-4 flex space-x-4" style="width:5rem;">
        <a href="#" class="hover:opacity-75">
          <img src="src/facebook.png" alt="Facebook">
        </a>
        <a href="#" class="hover:opacity-75">
          <img src="src/instagram.png" alt="Twitter">
        </a>
        <a href="#" class="hover:opacity-75">
          <img src="src/linkedin.png" alt="LinkedIn">
        </a>
      </div>
    </div>
  </div>
  <div class="mt-8 text-center text-sm text-gray-400">
    © 2024 Student Innovation Center. All rights reserved.
  </div>
</footer>
  
</body>
</html>
