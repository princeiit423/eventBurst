<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Innovation Center</title>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Montserrat:wght@400;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <style>
    .profile-image {
      animation: scaleIn 1s ease-out;
    }

    .event-card {
      animation: fadeInUp 1s ease-in;
    }

    @keyframes scaleIn {
      from {
        transform: scale(0.8);
        opacity: 0;
      }
      to {
        transform: scale(1);
        opacity: 1;
      }
    }

    @keyframes fadeInUp {
      from {
        transform: translateY(20px);
        opacity: 0;
      }
      to {
        transform: translateY(0);
        opacity: 1;
      }
    }

    
  /* Responsive design adjustments */
  @media (max-width: 768px) {
    .header {
      padding: 10px 4px;
      position:static;
    }
    .header nav {
      display: flex;
      flex-direction: column;
      gap: 4px;
      text-align:right;
    }
    .header nav a, .header nav button {
      font-size: 14px;
      text-align:right;
    }
  }

  </style>
</head>
 <!-- Header -->
<header class="header flex justify-between items-center py-4 px-8 bg-white shadow-md  w-full top-0 z-50">
  <div class="text-2xl font-bold text-indigo-600">Student <span class="text-black">Innovation</span> Center</div>
  <nav class="space-x-6 text-sm">
    <a href="#" class="hover:text-indigo-600">Home</a>
    <a href="/upcomingevent" class="hover:text-indigo-600">Upcoming Events</a>
    <a href="/pastEvent" class="hover:text-indigo-600">Past Events</a>
    <a href="/profile" class="hover:text-indigo-600">Profile</a>
    <a href="/contact" class="hover:text-indigo-600">Contacts</a>
    <a href="/admin" class="hover:text-indigo-600">Admin</a>
    <% if(admi){ %>
      <a href="/logout" class="px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">Logout</a>
    <% } else { %>
    <a href="/login" class="px-4 py-2 text-purple-600 hover:underline">Login</a>
    <a href="/signup" class="px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">Signup</a>
  <% } %>
  </nav>
</header>
<body class="bg-gray-100 font-sans">

  <!-- Profile Section -->
  <div class="max-w-6xl mx-auto my-10 p-6 bg-white rounded-lg shadow-lg border border-gray-200">

    <!-- User Information -->
    <div class="flex flex-col md:flex-row items-center space-y-6 md:space-y-0 md:space-x-10">
      <!-- Profile Image -->
      <div class="profile-image">
        <img src="https://img.freepik.com/premium-vector/user-circle-with-blue-gradient-circle_78370-4727.jpg?ga=GA1.1.1923722555.1729078714&semt=ais_hybrid" alt="User Profile" class="w-48 h-48 rounded-full shadow-lg border border-gray-300">
      </div>

      <!-- Basic Information -->
      <div class="flex-1">
        <h2 class="text-4xl font-bold text-indigo-600 mb-4"><%=user.username %></h2>
        <p class="text-gray-700 mb-4">A passionate participant of various tech events and workshops. Always eager to learn and grow in the field of technology.</p>
        <ul class="list-disc pl-5 text-gray-600 mb-4">
          <li><strong>Email:</strong> <%=user.email %></li>
          <li><strong>Department:</strong> <%=user.branch %>  </li>
          <li><strong>University Roll No:</strong> Updated soon...</li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <hr class="my-8 border-gray-300">

    <!-- Events Participated -->

    <div>
      <h3 class="text-3xl font-bold text-indigo-600 mb-6">Events <span class="text-black">Participated</span></h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Event Card -->
        <% for( e of data.event) { %>
        <div class="event-card bg-white border border-gray-200 shadow-lg rounded-lg p-6 hover:shadow-2xl transition duration-300 flex flex-col">
            <!-- Event Image -->
            <div class="event-image mb-4">
              <img src="<%=e.posterUrl%>" alt="Innovation Fest 2023" class="w-full h-40 object-cover rounded-lg shadow-sm">
            </div>
          
            <!-- Event Details -->
            <h4 class="text-xl font-semibold text-indigo-600 mb-2"><%=e.title%></h4>
            <p class="text-gray-700 mb-1"><strong>Date:</strong> <%=e.dateOfEvent.toLocaleDateString('en-US', {
              weekday: 'short',
              month: 'short',
              day: 'numeric',
              year: 'numeric',
            })%></p>
            <p class="text-gray-700 mb-1"><strong>Organised by:</strong> <%=e.club%></p>
            <p class="text-gray-700 mb-4"><strong>Location:</strong> <%=e.location%></p>
          
            <!-- Additional Information -->
            <div class="flex items-center space-x-2 mb-4">
              <div class="flex-shrink-0 bg-indigo-600 text-white rounded-full p-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm-1-11a1 1 0 012 0v2a1 1 0 01-2 0V7zm1 6a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd" />
                </svg>
              </div>
              <p class="text-gray-500 text-sm">
                "Shared insights on how innovation drives industry growth."
              </p>
            </div>
          
            <!-- Action Button -->
            <div class="mt-auto">
              <a href="/upcomingevent/<%=e._id %>">
              <button class="px-4 py-2 text-sm bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition duration-300 w-full">
                View Details
              </button>
              </a>
            </div>
          </div>
          <% } %>
          <!-- Add more events as needed -->
      </div>
      
    </div>
  </div>

  
 <!-- Footer -->
 <footer class="bg-indigo-900 text-white py-12">
  <div class="max-w-7xl mx-auto px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
    <!-- About Us -->
    <div>
      <h2 class="font-bold text-lg">Student Innovation Center</h2>
      <p class="mt-4 text-gray-400">
        Your ultimate platform to host, organize, and explore incredible events.
      </p>
    </div>
    <!-- Quick Links -->
    <div>
      <h2 class="font-bold text-lg">Quick Links</h2>
      <ul class="mt-4 space-y-2">
        <li><a href="#" class="hover:underline">Home</a></li>
        <li><a href="#upcoming" class="hover:underline">Upcoming Events</a></li>
        <li><a href="#past" class="hover:underline">Past Events</a></li>
        <li><a href="#contacts" class="hover:underline">Contacts</a></li>
      </ul>
    </div>
    <!-- Support -->
    <div>
      <h2 class="font-bold text-lg">Support</h2>
      <ul class="mt-4 space-y-2">
        <li><a href="#" class="hover:underline">Help Center</a></li>
        <li><a href="#" class="hover:underline">FAQs</a></li>
        <li><a href="#" class="hover:underline">Terms & Conditions</a></li>
        <li><a href="#" class="hover:underline">Privacy Policy</a></li>
      </ul>
    </div>
    <!-- Contact Us -->
    <div>
      <h2 class="font-bold text-lg">Contact Us</h2>
      <p class="mt-4 text-gray-400">
        Email: <a href="mailto:info@eventhive.com" class="underline">info@eventhive.com</a>
      </p>
      <p class="mt-2 text-gray-400">
        Phone: +123 456 7890
      </p>
      <div class="mt-4 flex space-x-4" style="width:5rem;">
        <a href="#" class="hover:opacity-75">
          <img src="src/facebook.png" alt="Facebook">
        </a>
        <a href="#" class="hover:opacity-75">
          <img src="src/instagram.png" alt="Twitter">
        </a>
        <a href="#" class="hover:opacity-75">
          <img src="src/linkedin.png" alt="LinkedIn">
        </a>
      </div>
    </div>
  </div>
  <div class="mt-8 text-center text-sm text-gray-400">
    © 2024 Student Innovation Center. All rights reserved.
  </div>
</footer>
</body>
</html>
