<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Event Ticket</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .ticket {
      width: 400px; /* Adjusted width */
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      overflow: hidden;
      margin: auto;
      background-color: #fff;
      position: relative;
    }
    .watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.1;
      font-size: 3rem;
      color: #7848F4;
      pointer-events: none;
      z-index: 0;
    }
    .ticket-content {
      position: relative;
      z-index: 2;
      padding: 15px;
    }
    .ticket-image {
      width: 100%;
      height: 300px; /* Adjusted height */
      object-fit: cover;
    }
  </style>
</head>
<body class="font-sans bg-gray-100 py-8 flex justify-center">

  <!-- Event Ticket -->
  <div class="ticket">
    <!-- Event Image -->
    <div class="relative">
      <img class="ticket-image" src="/src/tickets.png" alt="Event Image">
      <!-- Watermark -->
      <div class="watermark">Student Innovation Center</div>
    </div>

    <!-- Ticket Content -->
    <div class="ticket-content">
      <h2 class="text-2xl font-bold text-indigo-600"><%=singleEvent.title %></h2>
      <p class="mt-2 text-sm text-gray-600">Date: <%=singleEvent.dateOfEvent.toLocaleDateString('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        year: 'numeric',
      }) %></p>
      <p class="text-sm text-gray-500 mt-1">Venue: <%=singleEvent.location %></p>

      <div class="mt-4 space-y-2">
        <!-- order  id -->
        <div class="flex items-center justify-between">
          <span class="font-bold text-gray-700">Ticket Id:</span>
          <span class="text-gray-600"><%=newregister._id %></span>
        </div>
        <!-- Name -->
        <div class="flex items-center justify-between">
          <span class="font-bold text-gray-700">Name:</span>
          <span class="text-gray-600"><%=newregister.name %></span>
        </div>

        <!-- Department -->
        <div class="flex items-center justify-between">
          <span class="font-bold text-gray-700">Department:</span>
          <span class="text-gray-600"><%=newregister.department %></span>
        </div>

                <!-- Semester -->
                <div class="flex items-center justify-between">
                  <span class="font-bold text-gray-700">Semester:</span>
                  <span class="text-gray-600"><%= newregister.semester%></span>
                </div>

        <!-- Status -->
        <div class="flex items-center justify-between">
          <span class="font-bold text-gray-700">Status:</span>
          <span class="text-green-600 font-semibold">Confirmed</span>
        </div>
      </div>

      <div class="mt-6 text-center">
        <button class="px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">Download Ticket</button>
      </div>
    </div>
  </div>


</body>
</html>
