<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Innovation Center</title>
  <link rel="icon" href="src/favion.png" type="image/x-icon">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Montserrat:wght@400;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <style>
    @media (max-width: 640px) {
      .max-w-4xl {
        max-width: 100%;
        padding: 5px;
      }
      .text-4xl {
        font-size: 2rem;
      }
      .w-48 {
        width: 100px;
      }
      .h-48 {
        height: 100px;
      }
    }

    
        /* Responsive design adjustments */
        @media (max-width: 768px) {
          .header {
            padding: 10px 4px;
            position:static;
          }
          .header nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
            text-align:right
          }
          .header nav a, .header nav button {
            font-size: 14px;
            text-align:right;
          }
        }
         
  </style>
</head>
<body class="bg-gray-100 font-sans">


  <!-- Header -->
  <header class="header flex justify-between items-center py-4 px-8 bg-white shadow-md  w-full top-0 z-50">
    <div class="text-2xl font-bold text-indigo-600">Student <span class="text-black">Innovation</span> Center</div>
    <nav class="space-x-6 text-sm">
      <a href="#" class="hover:text-indigo-600">Home</a>
      <a href="/upcomingevent" class="hover:text-indigo-600">Upcoming Events</a>
      <a href="/pastEvent" class="hover:text-indigo-600">Past Events</a>
      <a href="/profile" class="hover:text-indigo-600">Profile</a>
      <a href="/contact" class="hover:text-indigo-600">Contacts</a>
      <a href="/admin" class="hover:text-indigo-600">Admin</a>
      <% if(admi){ %>
        <a href="/logout" class="px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">Logout</a>
      <% } else { %>
      <a href="/login" class="px-4 py-2 text-purple-600 hover:underline">Login</a>
      <a href="/signup" class="px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">Signup</a>
    <% } %>
    </nav>
  </header>
  <!-- Registration Form Container -->
  <div class="max-w-4xl mx-auto my-10 p-8 bg-white rounded-lg shadow-lg border border-gray-200">
    <h2 class="text-4xl font-bold mb-6 text-indigo-600 text-center">Add new Event</h2>
    <p class="text-gray-700 mb-6 text-center">Fill out the form below to add your new event.</p>

    <!-- Registration Form -->
    <form class="space-y-6" method="post" action="/addevent">
      <!-- Title Field -->
      <div>
        <label for="title" class="block text-gray-800 font-medium mb-2">Event Title</label>
        <input type="text" id="title" name="title" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-300 shadow-sm" placeholder="Tech Workshop 2024" required>
      </div>

      <!-- Description Field -->
      <div>
        <label for="description" class="block text-gray-800 font-medium mb-2">Description</label>
        <textarea id="description" name="description" rows="3" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-300 shadow-sm" placeholder="Event details here" required></textarea>
      </div>

      <!-- Date of Event Field -->
      <div>
        <label for="date" class="block text-gray-800 font-medium mb-2">Date of Event</label>
        <input type="date" id="dateOfEvent" name="dateOfEvent" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-300 shadow-sm" required>
      </div>

      <!-- Venue Field -->
      <div>
        <label for="venue" class="block text-gray-800 font-medium mb-2">Venue</label>
        <input type="text" id="location" name="location" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-300 shadow-sm" placeholder="Venue details here" required>
      </div>

      <!-- Entry Fee Field -->
      <div>
        <label for="entry-fee" class="block text-gray-800 font-medium mb-2">Entry Fee</label>
        <input type="text" id="entryFee" name="entryFee" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-300 shadow-sm" placeholder="Amount in Rupees" required>
      </div>

      <!-- Organized By Field -->
      <div>
        <label for="club" class="block text-gray-800 font-medium mb-2">Organized By</label>
        <input type="text" id="club" name="club" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-300 shadow-sm" placeholder="Organizing Club" required>
      </div>

      <!-- Poster URL Field -->
      <div>
        <label for="poster-url" class="block text-gray-800 font-medium mb-2">Poster URL</label>
        <input type="url" id="posterUrl" name="posterUrl" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-300 shadow-sm" placeholder="https://example.com/poster.jpg" required>
      </div>

      <!-- Submit Button -->
      <div class="flex justify-center mt-6">
        <button type="submit" class="px-6 py-3 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition duration-300 w-full sm:w-auto">Register Event</button>
      </div>
    </form>
  </div>

 <!-- Footer -->
 <footer class="bg-indigo-900 text-white py-12">
  <div class="max-w-7xl mx-auto px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
    <!-- About Us -->
    <div>
      <h2 class="font-bold text-lg">Student Innovation Center</h2>
      <p class="mt-4 text-gray-400">
        Your ultimate platform to host, organize, and explore incredible events.
      </p>
    </div>
    <!-- Quick Links -->
    <div>
      <h2 class="font-bold text-lg">Quick Links</h2>
      <ul class="mt-4 space-y-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li><a href="/upcomingevent" class="hover:underline">Upcoming Events</a></li>
        <li><a href="/pastevent" class="hover:underline">Past Events</a></li>
        <li><a href="/contact" class="hover:underline">Contacts</a></li>
      </ul>
    </div>
    <!-- Support -->
    <div>
      <h2 class="font-bold text-lg">Support</h2>
      <ul class="mt-4 space-y-2">
        <li><a href="#" class="hover:underline">Help Center</a></li>
        <li><a href="#" class="hover:underline">FAQs</a></li>
        <li><a href="#" class="hover:underline">Terms & Conditions</a></li>
        <li><a href="#" class="hover:underline">Privacy Policy</a></li>
      </ul>
    </div>
    <!-- Contact Us -->
    <div>
      <h2 class="font-bold text-lg">Contact Us</h2>
      <p class="mt-4 text-gray-400">
        Email: <a href="mailto:info@eventhive.com" class="underline">sic010@gmail.com</a>
      </p>
      <p class="mt-2 text-gray-400">
        Phone: +919832380487
      </p>
      <div class="mt-4 flex space-x-4" style="width:5rem;">
        <a href="#" class="hover:opacity-75">
          <img src="src/facebook.png" alt="Facebook">
        </a>
        <a href="#" class="hover:opacity-75">
          <img src="src/instagram.png" alt="Twitter">
        </a>
        <a href="#" class="hover:opacity-75">
          <img src="src/linkedin.png" alt="LinkedIn">
        </a>
      </div>
    </div>
  </div>
  <div class="mt-8 text-center text-sm text-gray-400">
    © 2024 Student Innovation Center. All rights reserved.
  </div>
</footer>

</body>
</html>
